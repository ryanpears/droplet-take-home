{
  "name": "webhook-delivery",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start-server": "node src/index.js",
    "start-worker": "node src/worker.js",
    "start-dashboard": "vite --config dashboard/vite.config.js dashboard",
    "start": "concurrently \"npm run start-server\" \"npm run start-worker\" \"npm run start-dashboard\"",
    "test": "NODE_ENV=test jest --runInBand",
    "db:reset": "node scripts/reset-db.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^10.0.3",
    "jest": "^29.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "supertest": "^7.1.0",
    "vite": "^6.3.5"
  }
}
